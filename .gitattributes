# =============================================================================
# PopolaLoom .gitattributes
#
# Normalize line endings, classify text vs. binary blobs, and mark generated
# artifacts so GitHub linguist hides them from language stats and renders
# their diffs as collapsible by default.
# =============================================================================


# === Defaults ===
# Auto-detect text files; normalize all checked-in text to LF (matches the
# Linux/CI environment and avoids "diff every file" churn from Windows CRLF).
* text=auto eol=lf


# === Text types ===
*.py        text diff=python
*.pyx       text diff=python
*.md        text
*.yaml      text
*.yml       text
*.json      text
*.toml      text
*.ini       text
*.cfg       text
*.sh        text eol=lf
Dockerfile  text
Makefile    text


# === Binary types ===
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.tar.gz    binary
*.tgz       binary
*.whl       binary
*.so        binary
*.dylib     binary
*.dll       binary


# === Generated (DevolaFlow compile artifacts) ===
# These files are emitted by `devola-init local` / `devola-init sync-rules`
# from sources under .rules/. Marking them linguist-generated=true tells
# GitHub to (a) exclude them from repo language statistics and (b) collapse
# their diffs in PR review by default. Source-of-truth lives in .rules/.
AGENTS.md                          linguist-generated=true
.rules/.compile-hashes.json        linguist-generated=true
.cursor/rules/repo-governance.mdc  linguist-generated=true
.local/index.md                    linguist-generated=true


# === Lockfiles ===
# Lockfiles are mechanically generated by their respective package managers.
# Mark binary so git skips diffing huge JSON / YAML hash blobs, and mark
# linguist-generated so they don't skew language stats either.
package-lock.json  binary linguist-generated=true
yarn.lock          binary linguist-generated=true
pnpm-lock.yaml     binary linguist-generated=true
poetry.lock        binary linguist-generated=true
Pipfile.lock       binary linguist-generated=true
uv.lock            binary linguist-generated=true
